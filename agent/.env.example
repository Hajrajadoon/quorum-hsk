# ============================================================================
#  QUORUM agent configuration. Copy to .env and fill in.
# ============================================================================

# "sim"  = full simulation, no keys needed (rehearsals, offline pitch backup)
# "live" = real QuorumVault on HSK Chain
MODE=sim

PORT=8787
HOST=127.0.0.1
# Optional: require this token (header x-quorum-token / dashboard ?token=) for chat & controls
CONTROL_TOKEN=

# Tick interval in ms (sim default 2500, live default 30000)
LOOP_MS=

# ---------------------------------------------------------------- simulation
SIM_SEED=1
SIM_DEPOSIT=10000

# ---------------------------------------------------------------- live (HSK Chain)
RPC_URL=https://mainnet.hsk.xyz
CHAIN_ID=177
VAULT_ADDRESS=0x...
# The agent's HOT key. It can trade inside the policy, it can NEVER withdraw.
AGENT_PRIVATE_KEY=0x...
# Minimum trade size in base units (e.g. 1 = 1 USDT)
MIN_TRADE=1
# Base amount used to probe the venue price
PRICE_PROBE=1
# Also commit HOLD / VETO decisions on-chain (costs gas every tick)
ATTEST_HOLDS=false
# Optional reference prices for spread/arbitrage detection: vault symbol -> CoinGecko id
# REF_PRICE_IDS={"WHSK":"hashkey-ecopoints","WETH":"ethereum"}
REF_PRICE_IDS=
# Only for the DeployDemo venue (MockAdapter): key of the adapter deployer, used to push
# simulated prices on-chain each tick so the demo shows real transactions.
MOCK_FEED_PRIVATE_KEY=
# Only push a new demo price when it moved at least this fraction (0.002 = 0.2%). Higher = cheaper.
MOCK_FEED_MIN_MOVE=0.002

# ---------------------------------------------------------------- AI (optional)
# Any OpenAI-compatible endpoint. Without a key the council uses its deterministic quant models.
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=anthropic/claude-3.5-haiku
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
