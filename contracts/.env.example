# ---- deployer / vault owner (keep this key OFF the agent server) ----
PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY
# the AI agent's hot wallet address (it can trade inside the policy, it can never withdraw)
AGENT_ADDRESS=0xYOUR_AGENT_ADDRESS

# ---- only for script/Deploy.s.sol (real HSKSwap) ----
# Verify every address on https://hsk.blockscout.com and https://app.hskswap.com before deploying.
BASE_TOKEN=0xUSDT_ON_HSK_CHAIN
TRADE_TOKENS=0xWHSK,0xWETH
ADAPTER_KIND=v3
ROUTER=0xHSKSWAP_ROUTER
QUOTER=0xHSKSWAP_QUOTER_V2
V3_LEGACY=false
V3_FEE=3000
